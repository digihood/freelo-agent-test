{
  "name": "freelo-agent-test",
  "version": "1.0.0",
  "description": "Test project for Save button feature validation",
  "main": "index.html",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose"
  },
  "keywords": [
    "testing",
    "html",
    "button",
    "accessibility"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jest": "^29.7.0",
    "jsdom": "^23.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "*.html"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
